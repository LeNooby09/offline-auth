{
  "schemaVersion": 1,
  "id": "crack-auth",
  "version": "${version}",
  "name": "CrackAuth",
  "description": "Server-side authentication mod with invite codes, password login, and display name override for offline-mode servers.",
  "authors": [],
  "contact": {},
  "license": "GPL-3.0",
  "environment": "server",
  "entrypoints": {
    "fabric-datagen": [
      "tech.lenooby09.crackAuth.client.CrackAuthDataGenerator"
    ],
    "main": [
      {
        "adapter": "kotlin",
        "value": "tech.lenooby09.crackAuth.CrackAuth"
      }
    ]
  },
  "mixins": [
    "crack-auth.mixins.json",
    {
      "config": "crack-auth.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
