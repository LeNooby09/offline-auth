{
  "schemaVersion": 1,
  "id": "offline-auth",
  "version": "${version}",
  "name": "OfflineAuth",
  "description": "Server-side authentication mod with invite codes, password login, and display name override for offline-mode servers.",
  "authors": [],
  "contact": {},
  "license": "GPL-3.0",
  "environment": "server",
  "entrypoints": {
    "fabric-datagen": [
      "tech.lenooby09.offlineAuth.client.OfflineAuthDataGenerator"
    ],
    "main": [
      {
        "adapter": "kotlin",
        "value": "tech.lenooby09.offlineAuth.OfflineAuth"
      }
    ]
  },
  "mixins": [
    "offline-auth.mixins.json",
    {
      "config": "offline-auth.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
